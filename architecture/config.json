    {"authority": "specified", "component": "architecture-policy", "id": "semantic-wiki", "kind": "projection", "label": "Agentic Commerce Intelligence wiki", "origin": {"path": "docs/ARCHITECTURE.md", "search": "Agentic Commerce Intelligence wiki"}, "page": "projection"},
    {"authority": "specified", "component": "runtime", "id": "runtime-service", "kind": "service", "label": "agent-economy-monitor", "origin": {"path": "src/main.rs", "search": "agent economy monitor listening"}, "page": "delivery"},
    {"authority": "mechanical", "component": "runtime", "id": "http:healthz", "kind": "endpoint", "label": "GET /healthz", "origin": {"method": "get", "path": "src/main.rs", "route": "/healthz"}, "page": "delivery"},
