  "invariants": [
    {
      "id": "evidence-canonical-projection-separated",
      "kind": "authority-boundary",
      "status": "holds",
      "why": "Evidence storage, canonical stores, and semantic wiki are distinct nodes joined only by explicit bounded flows."
    },
    {
      "id": "adapters-observation-only",
      "kind": "authority-boundary",
      "status": "holds",
      "why": "The only adapter output edge targets deterministic reducers and is labeled emits-observations."
    },
    {
      "id": "single-runtime-identity",
      "kind": "runtime-identity",
      "status": "holds",
      "why": "Exactly one runtime-service construction represents agent-economy-monitor; Cloud Run service and job nodes are deployment forms of that image, not additional product identities."
    },
    {
      "id": "no-shared-core-fallback",
      "kind": "placement",
      "status": "holds",
      "why": "Every internal construction names an explicit System Map page; Shared-core is forbidden."
    }
  ],
