{
  "boundary_groups": [
    {
      "description": "Public discovery and chain/provider boundaries remain untrusted evidence sources.",
      "id": "evidence-sources",
      "label": "External evidence sources",
      "members": [
        "external:agentcash",
        "external:rpc-provider",
        "external:web-discovery",
        "external:x402scan"
      ]
    },
    {
      "description": "Durable infrastructure is independently supervised and is not duplicated as an application runtime.",
      "id": "data-infrastructure",
      "label": "Data infrastructure",
      "members": [
        "store:clickhouse",
        "store:evidence",
        "store:postgresql",
        "store:redpanda"
      ]
    }
  ],
  "components": [
    {
      "description": "Axum process entry point and current HTTP status surface.",
      "id": "runtime",
      "label": "Runtime",
      "layer": "delivery",
      "patterns": [
        ".env.example",
        "Cargo.lock",
        "Cargo.toml",
        "src/**"
      ]
    },
    {
      "description": "Deterministic compiler, contract tests, and local architecture gate.",
      "id": "architecture-tooling",
      "label": "Architecture tooling",
      "layer": "governance",
      "patterns": [
        "architecture/config.json",
        "architecture/contract/**",
        "scripts/build_architecture.py",
        "scripts/check_architecture_contract.py",
        "scripts/test_architecture.py"
      ]
    },
    {
      "description": "Repository and CI gates that defend behavior and architecture independently.",
      "id": "delivery-gates",
      "label": "Delivery gates",
      "layer": "governance",
      "patterns": [
        ".gitignore",
        ".github/workflows/**",
        "scripts/verify"
      ]
    },
    {
      "description": "Human-authored product, trust, and runtime architecture authority.",
      "id": "architecture-policy",
      "label": "Architecture policy",
      "layer": "governance",
      "patterns": [
        "*.md",
        "docs/**"
      ]
    }
  ],
  "description": "Source-backed architecture of the Agent Economy Monitor, preserving deterministic evidence, canonical knowledge, and semantic projection as separate authorities.",
  "evidence_metadata": {
    "class": "repository-source-and-specified-policy",
    "limitations": [
      "Only the Axum status surface is implemented at this revision; product pipeline nodes are specified and explicitly reported as unresolved implementation coverage.",
      "Protocol semantics are declared from repository architecture documents until Rust adapters exist."
    ],
    "rules": {
      "ci.workflow": "Mechanically extracts job IDs and run commands from .github/workflows/ci.yml.",
      "declared.topology": "Resolves a unique repository-relative source citation for each specified construction.",
      "rust.declaration": "Extracts Rust item declarations from tracked Rust source.",
      "rust.http-route": "Extracts literal Axum route paths and handlers from Router::route calls."
    }
  },
  "externals": [
    {
      "category": "rpc-provider",
      "description": "One configured external RPC provider for Ethereum, Base, Solana, and Tempo.",
      "id": "rpc-provider",
      "label": "External RPC provider"
    },
    {
      "category": "discovery-seed",
      "description": "Untrusted x402 discovery seed; candidates require independent verification.",
      "id": "x402scan",
      "label": "x402scan"
    },
    {
      "category": "discovery-seed",
      "description": "Untrusted AgentCash discovery seed; candidates require independent verification.",
      "id": "agentcash",
      "label": "AgentCash"
    },
    {
      "category": "public-discovery",
      "description": "OpenAPI, well-known documents, registries, GitHub, submissions, and observed recipients.",
      "id": "web-discovery",
      "label": "Web discovery"
    }
  ],
  "flows": [
    {
      "authority": "specified",
      "evidence": [
        {
          "path": "docs/ARCHITECTURE.md",
          "search": "S[External RPC"
        }
      ],
      "id": "evidence-to-canonical",
      "page": "evidence",
      "steps": [
        {"from": "external:rpc-provider", "relation": "observes", "to": "collector"},
        {"from": "collector", "relation": "appends", "to": "store:redpanda"},
        {"from": "store:redpanda", "relation": "retains", "to": "store:evidence"},
        {"from": "store:redpanda", "relation": "feeds", "to": "protocol-adapters"},
        {"from": "protocol-adapters", "relation": "emits-observations", "to": "reducers"},
        {"from": "reducers", "relation": "writes-events", "to": "store:clickhouse"},
        {"from": "reducers", "relation": "feeds", "to": "attribution"},
        {"from": "attribution", "relation": "writes-claims", "to": "store:postgresql"}
      ],
      "summary": "Immutable observations become replayable canonical events and provenance-bearing claims.",
      "title": "Evidence to canonical knowledge"
    },
    {
      "authority": "specified",
      "evidence": [
        {
          "path": "docs/ARCHITECTURE.md",
          "search": "CH --> P[Bounded evidence snapshots]"
        }
      ],
      "id": "canonical-to-semantic-projection",
      "page": "projection",
      "steps": [
        {"from": "store:clickhouse", "relation": "bounds", "to": "evidence-snapshot"},
        {"from": "store:postgresql", "relation": "bounds", "to": "evidence-snapshot"},
        {"from": "store:evidence", "relation": "cites", "to": "evidence-snapshot"},
        {"from": "evidence-snapshot", "relation": "constrains", "to": "llm-projector"},
        {"from": "llm-projector", "relation": "writes-cited-projection", "to": "semantic-wiki"},
        {"from": "semantic-wiki", "relation": "serves", "to": "query-api"}
      ],
      "summary": "Bounded deterministic snapshots constrain cited narrative projection without granting canonical authority.",
      "title": "Canonical knowledge to semantic projection"
    }
  ],
  "interplay_edges": [
    {"class": "boundary", "relation": "observes", "source": "external:rpc-provider", "target": "collector"},
    {"class": "boundary", "relation": "seeds", "source": "external:x402scan", "target": "collector"},
    {"class": "boundary", "relation": "seeds", "source": "external:agentcash", "target": "collector"},
    {"class": "boundary", "relation": "discovers", "source": "external:web-discovery", "target": "collector"},
    {"class": "lifecycle", "relation": "appends", "source": "collector", "target": "store:redpanda"},
    {"class": "lifecycle", "relation": "retains", "source": "store:redpanda", "target": "store:evidence"},
    {"class": "interplay", "relation": "feeds", "source": "store:redpanda", "target": "protocol-adapters"},
    {"class": "interplay", "relation": "emits-observations", "source": "protocol-adapters", "target": "reducers"},
    {"class": "lifecycle", "relation": "writes-events", "source": "reducers", "target": "store:clickhouse"},
    {"class": "interplay", "relation": "feeds", "source": "reducers", "target": "attribution"},
    {"class": "lifecycle", "relation": "writes-claims", "source": "attribution", "target": "store:postgresql"},
    {"class": "interplay", "relation": "derives-features", "source": "store:clickhouse", "target": "classification"},
    {"class": "lifecycle", "relation": "writes-versioned-claims", "source": "classification", "target": "store:postgresql"},
    {"class": "interplay", "relation": "targets", "source": "store:postgresql", "target": "enrichment"},
    {"class": "boundary", "relation": "queries", "source": "enrichment", "target": "external:rpc-provider"},
    {"class": "interplay", "relation": "reads", "source": "query-api", "target": "store:clickhouse"},
    {"class": "interplay", "relation": "reads", "source": "query-api", "target": "store:postgresql"},
    {"class": "interplay", "relation": "serves", "source": "query-api", "target": "cockpit"},
    {"class": "interplay", "relation": "bounds", "source": "store:clickhouse", "target": "evidence-snapshot"},
    {"class": "interplay", "relation": "bounds", "source": "store:postgresql", "target": "evidence-snapshot"},
    {"class": "interplay", "relation": "cites", "source": "store:evidence", "target": "evidence-snapshot"},
    {"class": "interplay", "relation": "constrains", "source": "evidence-snapshot", "target": "llm-projector"},
    {"class": "lifecycle", "relation": "writes-cited-projection", "source": "llm-projector", "target": "semantic-wiki"},
    {"class": "interplay", "relation": "serves", "source": "semantic-wiki", "target": "query-api"},
    {"class": "structure", "relation": "exposes", "source": "runtime-service", "target": "http:healthz"},
    {"class": "structure", "relation": "exposes", "source": "runtime-service", "target": "http:status"}
  ],
  "invariants": [
    {
      "id": "evidence-canonical-projection-separated",
      "kind": "authority-boundary",
      "status": "holds",
      "why": "Evidence storage, canonical stores, and semantic wiki are distinct nodes joined only by explicit bounded flows."
    },
    {
      "id": "adapters-observation-only",
      "kind": "authority-boundary",
      "status": "holds",
      "why": "The only adapter output edge targets deterministic reducers and is labeled emits-observations."
    },
    {
      "id": "single-runtime-identity",
      "kind": "runtime-identity",
      "status": "holds",
      "why": "Exactly one runtime-service construction represents agent-economy-monitor; infrastructure remains boundary or store nodes."
    },
    {
      "id": "no-shared-core-fallback",
      "kind": "placement",
      "status": "holds",
      "why": "Every internal construction names an explicit System Map page; Shared-core is forbidden."
    }
  ],
  "inventory_globs": [
    ".env.example",
    ".github/workflows/*.yml",
    ".gitignore",
    "*.md",
    "Cargo.lock",
    "Cargo.toml",
