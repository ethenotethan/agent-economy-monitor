    {"authority": "specified", "component": null, "id": "external:agentcash", "kind": "external", "label": "AgentCash", "origin": {"path": "docs/PRODUCT.md", "search": "x402scan and AgentCash"}, "page": null},
    {"authority": "specified", "component": null, "id": "external:web-discovery", "kind": "external", "label": "Web discovery", "origin": {"path": "docs/PRODUCT.md", "search": "OpenAPI; well-known documents"}, "page": null}
