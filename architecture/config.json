{
  "boundary_groups": [
    {
      "description": "Public discovery and chain/provider boundaries remain untrusted evidence sources.",
      "id": "evidence-sources",
      "label": "External evidence sources",
      "members": [
        "external:agentcash",
        "external:rpc-provider",
        "external:web-discovery",
        "external:x402scan"
      ]
    },
    {
      "description": "Cloud SQL and Google Cloud Storage are independently supervised and are not duplicated as application runtimes.",
      "id": "data-infrastructure",
      "label": "Data infrastructure",
      "members": [
        "store:evidence",
        "store:postgresql"
      ]
    }
  ],
  "components": [
    {
      "description": "Axum process entry point and current HTTP status surface.",
      "id": "runtime",
      "label": "Runtime",
      "layer": "delivery",
      "patterns": [
        ".env.example",
        "Cargo.lock",
        "Cargo.toml",
        "src/**"
      ]
    },
    {
      "description": "Versioned Protobuf contracts and deterministic Rust validation for immutable observations and canonical event keys.",
      "id": "observation-contracts",
      "label": "Observation contracts",
      "layer": "evidence",
      "patterns": [
        "crates/contracts/**"
      ]
    },
    {
      "description": "Stateless Rust adapter boundary that permits protocol parsers to emit immutable observations only.",
      "id": "adapter-api",
      "label": "Adapter API",
      "layer": "evidence",
      "patterns": [
        "crates/adapter-api/**"
      ]
    },
    {
      "description": "Backend-neutral immutable evidence contract and content-addressed filesystem development adapter.",
      "id": "evidence-store",
      "label": "Evidence storage contract",
      "layer": "evidence",
      "patterns": [
        "crates/evidence-store/**"
      ]
    },
    {
      "description": "One-command lean local data plane with persistent ready PostgreSQL and filesystem evidence initialization.",
      "id": "development-stack",
      "label": "Local development stack",
      "layer": "delivery",
      "patterns": [
        "compose.yaml",
        "scripts/dev-stack"
      ]
    },
    {
      "description": "Namespace-scoped PostgreSQL schema for canonical services, commerce offers, buyer handles, reversible clusters, claims, evidence, and provenance.",
      "id": "knowledge-graph-schema",
      "label": "Canonical knowledge schema",
      "layer": "canonical",
      "patterns": [
        "migrations/0001_knowledge_graph.*.sql"
      ]
    },
    {
      "description": "Partitioned PostgreSQL observations, canonical events, settlements, leases, feature windows, analytical read models, and measured scale thresholds.",
      "id": "operational-analytics-schema",
      "label": "Observation and analytics schema",
      "layer": "canonical",
      "patterns": [
        "migrations/0002_operational_analytics.*.sql"
      ]
    },
    {
      "description": "Append-only shadow candidates, upstream aliases, independent verification signals, liveness history, and two-signal catalog promotion.",
      "id": "shadow-catalog-schema",
      "label": "Shadow catalog and promotion schema",
      "layer": "canonical",
      "patterns": [
        "migrations/0003_shadow_catalog.*.sql"
      ]
    },
    {
      "description": "Shared evidence-first Alchemy collector for Ethereum, Base, Solana, and Tempo with bounded retry, rate budgets, gap detection, and PostgreSQL compare-and-set cursors.",
      "id": "rpc-collector",
      "label": "External RPC collector",
      "layer": "evidence",
      "patterns": [
        "crates/rpc-collector/**"
      ]
    },
    {
      "description": "Deterministic canonical-event reconciliation and chain-specific finality engine with replay-stable state hashes, inspectable conflicts, and append-only reverted/orphaned history.",
      "id": "deterministic-reducer",
      "label": "Deterministic reducer and finality engine",
      "layer": "canonical",
      "patterns": [
        "crates/reducer/**",
        "migrations/0004_reducer_finality.*.sql"
      ]
    },
    {
      "description": "Deterministic observation-only parser for MPP OpenAPI discovery metadata.",
      "id": "mpp-adapter",
      "label": "MPP discovery adapter",
      "layer": "evidence",
      "patterns": [
        "crates/mpp-adapter/**"
      ]
    },
    {
      "description": "Deterministic x402 v1/v2 discovery parser with immutable evidence hashing, typed quarantine, and runtime-over-static authority selection.",
      "id": "x402-adapter",
      "label": "x402 adapter",
      "layer": "evidence",
      "patterns": [
        "crates/x402-adapter/**"
      ]
    },
    {
      "description": "Deterministic compiler, contract tests, and local architecture gate.",
      "id": "architecture-tooling",
      "label": "Architecture tooling",
      "layer": "governance",
      "patterns": [
        "architecture/config.json",
        "architecture/contract/**",
        "scripts/build_architecture.py",
        "scripts/check_architecture_contract.py",
        "scripts/test_architecture.py"
      ]
    },
    {
      "description": "Repository and CI gates that defend behavior and architecture independently.",
      "id": "delivery-gates",
      "label": "Delivery gates",
      "layer": "governance",
      "patterns": [
        ".gitignore",
        ".github/workflows/**",
        "scripts/verify",
        "tests/**"
      ]
    },
    {
      "description": "Human-authored product, trust, and runtime architecture authority.",
      "id": "architecture-policy",
      "label": "Architecture policy",
      "layer": "governance",
      "patterns": [
        "*.md",
        "docs/**"
      ]
    },
    {
      "description": "Public, model-driven GitHub Pages surface for inspecting the repository-owned System Map.",
      "id": "architecture-showcase",
      "label": "Architecture showcase",
      "layer": "experience",
      "patterns": [
        "site/**",
        "scripts/build_architecture_site.py",
        "scripts/test_architecture_site.py"
      ]
    }
  ],
  "description": "Source-backed architecture of the Agent Economy Monitor, preserving deterministic evidence, canonical knowledge, and semantic projection as separate authorities.",
  "evidence_metadata": {
    "class": "repository-source-and-specified-policy",
    "limitations": [
      "The Axum status surface, observation contracts, deterministic MPP and x402 discovery adapters, external RPC collector, deterministic reducer and chain-specific finality engine, PostgreSQL cursor client, local PostgreSQL development stack, canonical PostgreSQL knowledge schema, operational and analytical PostgreSQL schema, shadow catalog promotion schema, and content-addressed filesystem evidence adapter are implemented at this revision; Google Cloud Storage and remaining production PostgreSQL clients and the remaining product pipeline are specified and explicitly reported as unresolved implementation coverage.",
      "MPP OpenAPI and x402 discovery are implemented; runtime MPP challenge parsing remains unresolved."
    ],
    "rules": {
      "ci.workflow": "Mechanically extracts job IDs and run commands from .github/workflows/ci.yml.",
      "declared.topology": "Resolves a unique repository-relative source citation for each specified construction.",
      "rust.declaration": "Extracts Rust item declarations from tracked Rust source.",
      "rust.http-route": "Extracts literal Axum route paths and handlers from Router::route calls."
    }
  },
  "externals": [
    {
      "category": "rpc-provider",
      "description": "One configured external RPC provider for Ethereum, Base, Solana, and Tempo.",
      "id": "rpc-provider",
      "label": "External RPC provider"
    },
    {
      "category": "discovery-seed",
      "description": "Untrusted x402 discovery seed; candidates require independent verification.",
      "id": "x402scan",
      "label": "x402scan"
    },
    {
      "category": "discovery-seed",
      "description": "Untrusted AgentCash discovery seed; candidates require independent verification.",
      "id": "agentcash",
      "label": "AgentCash"
    },
    {
      "category": "public-discovery",
      "description": "OpenAPI, well-known documents, registries, GitHub, submissions, and observed recipients.",
      "id": "web-discovery",
      "label": "Web discovery"
    }
  ],
  "flows": [
    {
      "authority": "specified",
      "evidence": [
        {
          "path": "docs/ARCHITECTURE.md",
          "search": "S[External RPC"
        }
      ],
      "id": "evidence-to-canonical",
      "page": "evidence",
      "steps": [
        {"from": "external:rpc-provider", "relation": "observes", "to": "collector"},
        {"from": "collector", "relation": "archives", "to": "store:evidence"},
        {"from": "collector", "relation": "enqueues", "to": "store:postgresql"},
        {"from": "store:postgresql", "relation": "leases", "to": "protocol-adapters"},
        {"from": "store:evidence", "relation": "supplies", "to": "protocol-adapters"},
        {"from": "protocol-adapters", "relation": "emits-observations", "to": "reducers"},
        {"from": "reducers", "relation": "writes-events", "to": "store:postgresql"},
        {"from": "reducers", "relation": "feeds", "to": "attribution"},
        {"from": "attribution", "relation": "writes-claims", "to": "store:postgresql"}
      ],
      "summary": "Immutable observations become replayable canonical events and provenance-bearing claims.",
      "title": "Evidence to canonical knowledge"
    },
    {
      "authority": "specified",
      "evidence": [
        {
          "path": "migrations/0003_shadow_catalog.up.sql",
          "search": "CREATE TRIGGER catalog_promotions_two_signal_policy"
        }
      ],
      "id": "discovery-to-verified-catalog",
      "page": "canonical",
      "steps": [
        {"from": "external:x402scan", "relation": "seeds-aliases", "to": "shadow-catalog"},
        {"from": "external:agentcash", "relation": "seeds-aliases", "to": "shadow-catalog"},
        {"from": "external:web-discovery", "relation": "verifies", "to": "shadow-catalog"},
        {"from": "shadow-catalog", "relation": "promotes-two-signal", "to": "store:postgresql"}
      ],
      "summary": "Untrusted upstream identities remain aliases while independently sourced signal kinds gate canonical catalog visibility.",
      "title": "Discovery seeds to verified catalog"
    },
    {
      "authority": "specified",
      "evidence": [
        {
          "path": "docs/ARCHITECTURE.md",
          "search": "PG --> P[Bounded evidence snapshots]"
        }
      ],
      "id": "canonical-to-semantic-projection",
      "page": "projection",
      "steps": [
        {"from": "store:postgresql", "relation": "bounds", "to": "evidence-snapshot"},
        {"from": "store:evidence", "relation": "cites", "to": "evidence-snapshot"},
        {"from": "local-wiki-projector", "relation": "pulls", "to": "evidence-snapshot"},
        {"from": "local-wiki-projector", "relation": "runs", "to": "llm-projector"},
        {"from": "llm-projector", "relation": "writes-cited-projection", "to": "semantic-wiki"},
        {"from": "local-wiki-projector", "relation": "writes-native", "to": "semantic-wiki"},
        {"from": "semantic-wiki", "relation": "publishes-approved", "to": "projection-mirror"},
        {"from": "projection-mirror", "relation": "archives", "to": "store:evidence"},
        {"from": "projection-mirror", "relation": "indexes", "to": "store:postgresql"},
        {"from": "projection-mirror", "relation": "serves", "to": "query-api"}
      ],
      "summary": "Bounded deterministic snapshots constrain cited narrative projection without granting canonical authority.",
      "title": "Canonical knowledge to semantic projection"
    },
    {
      "authority": "specified",
      "evidence": [
        {
          "path": "docs/ARCHITECTURE.md",
          "search": "I[One Rust image]"
        }
      ],
      "id": "cloud-runtime-to-dashboard",
      "page": "delivery",
      "steps": [
        {"from": "runtime-service", "relation": "deployed-as", "to": "cloud-run-api"},
        {"from": "runtime-service", "relation": "executes-as", "to": "cloud-run-jobs"},
        {"from": "cloud-scheduler", "relation": "invokes", "to": "cloud-run-jobs"},
        {"from": "cloud-run-api", "relation": "hosts", "to": "query-api"},
        {"from": "cloud-run-jobs", "relation": "hosts", "to": "collector"},
        {"from": "cloud-run-jobs", "relation": "hosts", "to": "reducers"}
      ],
      "summary": "One Rust image serves the scale-to-zero dashboard and bounded scheduled workers without creating another product authority.",
      "title": "Cloud runtime to dashboard"
    }
  ],
