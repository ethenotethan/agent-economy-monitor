    {"authority": "specified", "component": "architecture-policy", "id": "attribution", "kind": "worker", "label": "Attribution engine", "origin": {"path": "docs/ARCHITECTURE.md", "search": "Attribution engine"}, "page": "canonical"},
    {"authority": "specified", "component": "architecture-policy", "id": "classification", "kind": "worker", "label": "Behavioral classification", "origin": {"path": "docs/ARCHITECTURE.md", "search": "Behavioral features and rule classifiers"}, "page": "canonical"},
    {"authority": "specified", "component": "architecture-policy", "id": "enrichment", "kind": "worker", "label": "Targeted buyer enrichment", "origin": {"path": "docs/ARCHITECTURE.md", "search": "Targeted buyer enrichment"}, "page": "canonical"},
