    {"authority": "specified", "component": "architecture-policy", "id": "protocol-adapters", "kind": "adapter", "label": "Stateless x402 / MPP adapters", "origin": {"path": "docs/ARCHITECTURE.md", "search": "Stateless Rust adapters"}, "page": "evidence"},
