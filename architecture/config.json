    {"authority": "specified", "component": "architecture-policy", "id": "store:evidence", "kind": "store", "label": "S3 immutable evidence", "origin": {"path": "docs/ARCHITECTURE.md", "search": "S3 immutable evidence"}, "page": "evidence"},
