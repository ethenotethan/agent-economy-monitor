#!/usr/bin/env bash
set -euo pipefail

PYTHON="${PYTHON:-/usr/bin/python3}"
: "${AEM_COLLECT_TEST_DATABASE_URL:?AEM_COLLECT_TEST_DATABASE_URL is required for canonical verification}"

"$PYTHON" -m unittest scripts.test_architecture -v
"$PYTHON" -m unittest scripts.test_architecture_site -v
"$PYTHON" -m unittest discover -s tests -p '*_test.py' -v
"$PYTHON" scripts/check_architecture_contract.py
"$PYTHON" scripts/build_architecture.py --check

for migration in migrations/*.up.sql; do
    psql "$AEM_COLLECT_TEST_DATABASE_URL" -v ON_ERROR_STOP=1 -f "$migration" >/dev/null
done

psql "$AEM_COLLECT_TEST_DATABASE_URL" -v ON_ERROR_STOP=1 -f migrations/0021_x402_history_backfill.down.sql >/dev/null
psql "$AEM_COLLECT_TEST_DATABASE_URL" -v ON_ERROR_STOP=1 -f migrations/0021_x402_history_backfill.up.sql >/dev/null

AEM_DISCOVERY_TEST_DATABASE_URL="$AEM_COLLECT_TEST_DATABASE_URL" \
    "$PYTHON" -m unittest discover -s tests -p 'discovery_pulse_schema_test.py' -v

cargo fmt --all -- --check
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo test --test collect_worker_postgres -- --nocapture
cargo test --test reduce_worker_postgres -- --nocapture
cargo test --workspace --all-targets --all-features

if git grep -nE '(ghp_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|/v2/[A-Za-z0-9_-]{24,})' -- ':!Cargo.lock'; then
    echo 'possible credential found in tracked files' >&2
    exit 1
fi
